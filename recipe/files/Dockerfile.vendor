# VENDOR STAGE (online): `make source-dist` fetches every erlang.mk dep into deps/ + bundles a
# self-contained source tarball + apt CVE-upgrade deb closure -> ./vendored, for a hermetic --network=none build.
FROM elixir:1.20-otp-28-slim@sha256:a61672ebbafaf93ec6baeee14657fa73407e4f7fe57e92b2e3f063d25d0d3244 AS erlvendor
RUN apt-get update && apt-get install -y --no-install-recommends build-essential make git ca-certificates zip unzip p7zip-full xz-utils rsync xsltproc python3 perl libssl-dev libncurses-dev zlib1g-dev && rm -rf /var/lib/apt/lists/*
WORKDIR /src
RUN git clone --depth 1 --branch v4.4.1 -q https://github.com/rabbitmq/rabbitmq-server . && test "$(git rev-parse HEAD)" = aa914c53d2f40f4be3d3a8738d0d5018ea1537e4
# source-dist populates deps/ (every erlang.mk dep, in-tree) so the offline make needs no git fetch.
RUN make source-dist PROJECT_VERSION=4.4.1
RUN rm -rf .git
# build-deb vendor: the offline build base lacks make/gcc/xz (unlike rust:bookworm which bakes
# its toolchain in); vendor the BUILD toolchain as debs so the --network=none `make` stage can
# dpkg-install them (no apt online). Downloaded on the SAME pinned base used for the offline build.
FROM ubuntu:24.04@sha256:9c7f200c07e3d4a03e7249d2c16bf66a51120fb876aa2242cf31451412543289 AS builddebvendor
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && \
    apt-get -y --download-only --no-install-recommends install \
      build-essential make git ca-certificates zip unzip p7zip-full xz-utils rsync xsltproc python3 perl libssl-dev libncurses-dev zlib1g-dev && \
    mkdir -p /build-debs && (cp /var/cache/apt/archives/*.deb /build-debs/ 2>/dev/null || true) && echo "vendored $(ls -1 /build-debs/*.deb 2>/dev/null | wc -l) build-debs"
