    mkdir -p /opt/chisel-releases && tar -xzf /tmp/releases.tgz -C /opt/chisel-releases --strip-components=1
RUN mkdir -p /rootfs /cache && XDG_CACHE_HOME=/cache chisel cut --release /opt/chisel-releases --root /rootfs base-files_base base-files_release-info base-files_chisel base-passwd_data ca-certificates_data tzdata_zoneinfo dash_bins coreutils_output-of-entire-files coreutils_env coreutils_echo coreutils_test coreutils_tr-utility coreutils_sort coreutils_head coreutils_tail coreutils_cut coreutils_printf coreutils_working-context coreutils_system-context coreutils_basename coreutils_dirname coreutils_rm-utility coreutils_ln-utility coreutils_readlink coreutils_date coreutils_timeout coreutils_delaying coreutils_bins tar_tar libssl3t64_libs libtinfo6_libs zlib1g_libs libstdc++6_libs libgcc-s1_libs libc-bin_locale
RUN set -eu; mkdir -p /chisel/debs /rootfs/var/lib/dpkg; : > /tmp/status; : > /chisel/packages.tsv; \
